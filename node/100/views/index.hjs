<a href="/addContact"><button>add contact</button></a>
<table id="contactsTable">
  <thead>
    <tr>
      <th>First</th>
      <th>Last</th>
      <th>Email</th>
      <th>Phone</th>
      <th>ID</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    {{#noContacts}}
    <tr>
      <td colspan="5">No contacts loaded</td>
    </tr>
    {{/noContacts}}

    {{#contacts}}
      <tr>
        <td>{{first}}</td>
        <td>{{last}}</td>
        <td>{{email}}</td>
        <td>{{phone}}</td>
        <td>{{id}}</td>
        <td>
          <form method="post" action="/deleteContact/{{id}}">
            <button>delete</button>
            <button formmethod="get" formaction="/addContact" value={{id}} name="id">edit</button>
          </form>
        </td>
      </tr>
     {{/contacts}}
  </tbody>
</table>
